# VNCompress-VI v2 -- API credentials for the dataset build.
# Copy to `.env` and fill in. `.env` is gitignored; this template is not, so
# NEVER put a real key in this file.
#
#   cp .env.example .env
#
# Loaded automatically by scripts/generate_compression_pairs.py (teacher) and
# scripts/verify_eval_set.py (judge). No library needed -- vncompress/api_pool.py
# reads it.

# ---------------------------------------------------------------------------
# Teacher -- generates the `compression` config (stage 3)
# ---------------------------------------------------------------------------
VNCOMPRESS_TEACHER_BASE_URL=https://token-api.fpt.ai/v1
VNCOMPRESS_TEACHER_MODEL=GLM-5.2

# One key gets ~50 requests/minute. Four keys are read as one pool with four
# independent rate budgets: ~200 req/min, and a key that starts returning 429
# cools down on its own while the other three keep working.
#
# The keys MUST be distinct. The same key pasted into two slots is one rate
# budget wearing two names -- the pool would look 4x provisioned and run
# straight into the limit. Duplicates are dropped with a warning.
VNCOMPRESS_TEACHER_API_KEY_1=<key-1>
VNCOMPRESS_TEACHER_API_KEY_2=<key-2>
VNCOMPRESS_TEACHER_API_KEY_3=<key-3>
VNCOMPRESS_TEACHER_API_KEY_4=<key-4>

# ---------------------------------------------------------------------------
# Judge -- verifies the independent test set (stage 4)
# ---------------------------------------------------------------------------
# MUST NOT be the teacher model. A judge sharing the teacher's blind spots
# certifies exactly the compressions the teacher gets wrong, and agrees with
# itself while doing it. scripts/verify_eval_set.py refuses the combination.
VNCOMPRESS_JUDGE_BASE_URL=https://token-api.fpt.ai/v1
VNCOMPRESS_JUDGE_MODEL=Llama-3.3-70B-Instruct

# Leave unset to reuse the teacher keys (same provider, same quota pool).
# Set them to run the judge on separate credentials.
# VNCOMPRESS_JUDGE_API_KEY_1=<key-1>
# VNCOMPRESS_JUDGE_API_KEY_2=<key-2>
# VNCOMPRESS_JUDGE_API_KEY_3=<key-3>
# VNCOMPRESS_JUDGE_API_KEY_4=<key-4>

# ---------------------------------------------------------------------------
# Pool tuning -- override per run with --rpm / --ccu-per-key
# ---------------------------------------------------------------------------
# Provider limit per key, in requests per minute.
VNCOMPRESS_RPM=150
# In-flight requests per key. 4 x 10 = 40 concurrent.
VNCOMPRESS_CCU_PER_KEY=20

# Output cap per call. A cap, not a reservation -- billing is on tokens
# actually generated, so a high cap costs nothing when unused, while a
# truncated compression costs the whole sample.
VNCOMPRESS_MAX_TOKENS=32768

# Ceiling shared by every key. The provider says "150 RPM" without saying
# whether that is per key or per account; a shared ceiling is correct under
# both readings. 0 disables.
VNCOMPRESS_ACCOUNT_RPM=150
