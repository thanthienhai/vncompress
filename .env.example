# Copy to .env and fill in. .env is gitignored; this file is committed and
# must contain placeholders only -- never a real key.
#
# Teacher LLM for the dataset-distillation stage (docs/dataset_pipeline.md §4).
# Any OpenAI-compatible /chat/completions endpoint works; the base URL must
# include the version path (e.g. .../v1).

VNCOMPRESS_TEACHER_BASE_URL=https://your-endpoint.example.com/v1
VNCOMPRESS_TEACHER_API_KEY=sk-replace-me
VNCOMPRESS_TEACHER_MODEL=your-model-name

# Generation parameters. §14: low temperature for extraction/labeling;
# raise it only when sampling diverse candidates for preference pairs.
VNCOMPRESS_TEACHER_TEMPERATURE=0.1
VNCOMPRESS_TEACHER_MAX_TOKENS=4096
VNCOMPRESS_TEACHER_TIMEOUT=120
# Retry: một request lỗi sẽ đợi RETRY_DELAY giây rồi gửi lại, tối đa
# MAX_ATTEMPTS lần. Hết lượt thì ghi vào data/teacher/failures_<stage>.jsonl
# để trace lại sau (scripts/inspect_failures.py).
VNCOMPRESS_TEACHER_MAX_ATTEMPTS=3
VNCOMPRESS_TEACHER_RETRY_DELAY=30
