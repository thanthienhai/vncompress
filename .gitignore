__pycache__/
.pytest_cache/
.ruff_cache/
.venv/

# Generated by scripts/build_viquad_eval.py from taidng/UIT-ViQuAD2.0, whose
# license is not stated on Hugging Face -- not committed by default pending
# verification against the original UIT-ViQuAD paper/repo. See
# data/benchmark/PROVENANCE.md. (training_corpus_v1.json from
# build_training_corpus.py IS safe to commit -- CC-BY-SA 4.0 + MIT sources --
# and is not excluded here; commit it deliberately if you want it as the
# new default training corpus, together with an updated CHECKSUMS.json.)
data/benchmark/vcc_bench_uit_viquad_qa.json

# Trained model weights -- too large for git (GitHub hard-rejects blobs
# over 100MB, and models/slm/final/adapter_model.safetensors alone is
# ~300MB). Keep these out of version control; distribute via
# releases/artifact storage or Git LFS instead. NOT excluded:
# tone_probe.pt (a few hundred KB -- a small linear-probe classifier, not a
# full model) and the small adapter config/tokenizer files, which are safe
# and useful to commit alongside config.json/environment.json under results/
# so a run is traceable back to the model that produced it.
models/**/*.safetensors
models/**/*.bin
models/**/pytorch_model*.pt

# Teacher-distillation generation outputs -- ~80k files once the pipeline runs.
# Must stay ignored: when this directory exists unignored, opencode snapshots all
# 80k files into its shadow git repo and then hangs indefinitely in
# Snapshot.track() on every message.
data/teacher/

# Generated by the v2 build pipeline (fetch_sources_v2 -> build_vncompress_vi_v2
# -> generate_compression_pairs). Large and fully reproducible from the source
# datasets plus the seed, so the row files are not committed; the provenance
# (split manifest, leak check, checksums) is small and is.
data/raw_v2/
data/vncompress_vi_v2/*.jsonl
data/vncompress_vi_v2/extras/
data/vncompress_vi_v2/eval/
# Resume state and dry-run rehearsals, not data. The rest of provenance/ IS
# committed -- split manifest, leak check, checksums, verification report and
# the human review queue are the evidence the build happened as described.
data/vncompress_vi_v2/_dryrun/
data/vncompress_vi_v2/provenance/compression_checkpoint*.jsonl
data/vncompress_vi_v2/provenance/batch_manifest.json
# Per-batch shards ARE the rows -- same data as compression.jsonl, just not
# merged yet. 35MB and climbing.
data/vncompress_vi_v2/provenance/shards/
# Run logs and the API error journal: per-run artifacts that churn on every
# invocation and say nothing about the dataset itself.
data/vncompress_vi_v2/provenance/*.log
data/vncompress_vi_v2/provenance/api_errors*.jsonl

# Agent tooling artifacts (opencode / oh-my-openagent / codegraph) -- local only.
.codegraph
.omo/

# API credentials. `.env.example` is the committed template.
.env
.env.local
